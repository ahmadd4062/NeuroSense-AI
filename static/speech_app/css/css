/* =========================
   OUR ASSESSMENTS SECTION
========================= */

.features-section {
    padding: 95px 0;
    background:
        radial-gradient(
            circle at 85% 10%,
            rgba(11, 114, 239, 0.07),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #f6faff 0%,
            #edf6ff 100%
        );
}

.features-container {
    width: min(1280px, calc(100% - 70px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 38% 62%;
    align-items: start;
    gap: 70px;
}

/* Left content */

.features-intro {
    position: sticky;
    top: 105px;
    max-width: 465px;
    padding-top: 12px;
}

.features-intro .section-label {
    margin-bottom: 15px;
}

.features-intro h2 {
    color: var(--navy);
    font-size: clamp(38px, 3.35vw, 51px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -1.5px;
}

.features-intro h2 span {
    display: block;
    color: var(--primary);
}

.features-intro > p {
    max-width: 455px;
    margin-top: 27px;
    color: #596b86;
    font-size: 14px;
    line-height: 1.75;
}

/* Cards list */

.features-list {
    display: flex;
    flex-direction: column;
    gap: 17px;
}

/* Assessment card */

.feature-card {
    min-height: 172px;
    padding: 18px;
    border: 1px solid rgba(184, 207, 235, 0.92);
    border-radius: 16px;
    display: grid;
    grid-template-columns: 175px 1fr;
    align-items: stretch;
    gap: 26px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 11px 28px rgba(49, 86, 134, 0.045);
    overflow: hidden;
    transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease,
        background 0.35s ease;
}

.feature-card:hover {
    background: #ffffff;
    border-color: rgba(11, 114, 239, 0.42);
    box-shadow: 0 17px 38px rgba(40, 82, 138, 0.10);
    transform: translateY(-4px);
}

/* Coloured illustration block */

.feature-card-visual {
    width: 175px;
    min-height: 136px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.4s ease;
}

.feature-card:hover .feature-card-visual {
    transform: scale(1.018);
}

.feature-card-visual::before,
.feature-card-visual::after {
    content: "";
    position: absolute;
    border-radius: 50%;
}

.feature-card-visual::before {
    width: 135px;
    height: 135px;
    right: -48px;
    bottom: -48px;
    background: rgba(255, 255, 255, 0.18);
}

.feature-card-visual::after {
    width: 70px;
    height: 70px;
    top: -22px;
    left: -18px;
    border: 1px solid rgba(255, 255, 255, 0.35);
}

.feature-card-visual i {
    position: relative;
    z-index: 2;
    font-size: 48px;
}

/* Individual card colours */

.feature-video {
    color: #126ee8;
    background: linear-gradient(145deg, #dcecff, #c1dcff);
}

.feature-audio {
    color: #754be5;
    background: linear-gradient(145deg, #eee8ff, #ddd2ff);
}

.feature-behavior {
    color: #0ca37c;
    background: linear-gradient(145deg, #dff9f1, #c2eedf);
}

.feature-report {
    color: #e98c2d;
    background: linear-gradient(145deg, #fff1dc, #ffe0ae);
}

.feature-records {
    color: #146bd9;
    background: linear-gradient(145deg, #dceaff, #c5dcfa);
}

/* Card text */

.feature-card-content {
    padding: 7px 10px 7px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.feature-number {
    display: block;
    margin-bottom: 7px;
    color: var(--primary);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
}

.feature-card-content h3 {
    margin-bottom: 9px;
    color: var(--navy);
    font-size: 21px;
    line-height: 1.25;
    font-weight: 600;
}

.feature-card-content p {
    max-width: 445px;
    color: #60708a;
    font-size: 13px;
    line-height: 1.65;
}

/* Remove card screening links even if still in HTML */

.feature-card-link {
    display: none;
}

/* Scroll entrance animation */

.feature-card {
    opacity: 0;
    transform: translateY(24px);
}

.feature-card.feature-visible {
    opacity: 1;
    transform: translateY(0);
    transition:
        opacity 0.65s ease,
        transform 0.65s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease,
        background 0.35s ease;
}

.feature-card.feature-visible:hover {
    transform: translateY(-4px);
}


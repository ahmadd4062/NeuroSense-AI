/* =========================
   SHARED BUTTON STYLING
========================= */

.btn,
.about-button,
.features-main-button {
    min-height: 46px;
    width: fit-content;
    padding: 0 23px;
    border: 1px solid var(--primary);
    border-radius: 9px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #ffffff;
    background: var(--primary);
    box-shadow: 0 11px 24px rgba(11, 114, 239, 0.16);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    transition:
        color 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease;
}

.btn::before,
.about-button::before,
.features-main-button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--primary-dark);
    transform: translateX(-102%);
    transition: transform 0.42s cubic-bezier(0.65, 0, 0.35, 1);
}

.btn:hover::before,
.about-button:hover::before,
.features-main-button:hover::before {
    transform: translateX(0);
}

.btn span,
.btn i,
.about-button span,
.about-button i,
.features-main-button span,
.features-main-button i {
    position: relative;
    z-index: 2;
}

.btn i,
.about-button i,
.features-main-button i {
    font-size: 12px;
    transition: transform 0.3s ease;
}

.btn:hover i,
.about-button:hover i,
.features-main-button:hover i {
    transform: translateX(4px);
}

.btn:hover,
.about-button:hover,
.features-main-button:hover {
    color: #ffffff;
    border-color: var(--primary-dark);
    box-shadow: 0 14px 30px rgba(11, 114, 239, 0.22);
}

/* Primary buttons */

.btn-primary {
    color: #ffffff;
    background: var(--primary);
    border-color: var(--primary);
}

/* Outline buttons */

.btn-login,
.btn-outline {
    color: var(--primary);
    background: #ffffff;
    border-color: #8bb8ef;
    box-shadow: none;
}

.btn-login::before,
.btn-outline::before {
    background: var(--primary);
}

.btn-login:hover,
.btn-outline:hover {
    color: #ffffff;
    border-color: var(--primary);
    box-shadow: 0 10px 24px rgba(11, 114, 239, 0.14);
}

.btn-outline:hover .fa-play {
    transform: translateX(2px);
}

/* Navbar button size */

.nav-actions .btn {
    min-height: 40px;
    padding: 0 24px;
}

/* Hero button size */

.btn-hero {
    min-height: 48px;
    padding: 0 25px;
    font-size: 14px;
}

/* About button */

.about-button {
    min-height: 47px;
}

/* Assessment main button */

.features-main-button {
    min-height: 48px;
    margin-top: 30px;
    padding: 0 24px;
    font-size: 14px;
}

/* =========================
   EARLY SIGNS SECTION
========================= */

.signs-section {
    padding: 100px 0;
    background: #ffffff;
}

.signs-container {
    width: min(1240px, calc(100% - 70px));
    margin: 0 auto;
}

.signs-header {
    max-width: 720px;
    margin: 0 auto 65px;
    text-align: center;
}

.signs-label {
    justify-content: center;
    margin-bottom: 14px;
}

.signs-header h2 {
    color: var(--navy);
    font-size: clamp(36px, 3.3vw, 50px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -1.4px;
}

.signs-header > p {
    max-width: 670px;
    margin: 20px auto 0;
    color: var(--text);
    font-size: 15px;
    line-height: 1.75;
}

.signs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 65px;
    row-gap: 55px;
}

.sign-card {
    min-height: 175px;
    padding: 10px 5px 20px;
    position: relative;
    border-bottom: 1px solid #e7eef7;
    transition:
        transform 0.3s ease,
        border-color 0.3s ease;
}

.sign-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
}

.sign-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 23px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    color: var(--primary);
    background: #eef6ff;
    font-size: 20px;
    transition:
        color 0.3s ease,
        background 0.3s ease,
        transform 0.3s ease;
}

.sign-card:hover .sign-icon {
    color: #ffffff;
    background: var(--primary);
    transform: translateY(-3px);
}

.sign-card h3 {
    margin-bottom: 11px;
    color: var(--navy);
    font-size: 17px;
    line-height: 1.3;
    font-weight: 600;
}

.sign-card p {
    max-width: 315px;
    color: #68758b;
    font-size: 13px;
    line-height: 1.7;
}

/* Entrance animation */

.sign-card {
    opacity: 0;
    transform: translateY(24px);
}

.sign-card.sign-visible {
    opacity: 1;
    transform: translateY(0);
    transition:
        opacity 0.65s ease,
        transform 0.65s ease,
        border-color 0.3s ease;
}

.sign-card.sign-visible:hover {
    transform: translateY(-5px);
}

/* Responsive */

@media (max-width: 900px) {
    .signs-section {
        padding: 80px 0;
    }

    .signs-container {
        width: min(100% - 40px, 760px);
    }

    .signs-grid {
        grid-template-columns: repeat(2, 1fr);
        column-gap: 45px;
        row-gap: 45px;
    }
}

@media (max-width: 600px) {
    .signs-section {
        padding: 65px 0;
    }

    .signs-container {
        width: calc(100% - 28px);
    }

    .signs-header {
        margin-bottom: 45px;
    }

    .signs-header h2 {
        font-size: 36px;
        letter-spacing: -1px;
    }

    .signs-header > p {
        font-size: 14px;
    }

    .signs-grid {
        grid-template-columns: 1fr;
        row-gap: 32px;
    }

    .sign-card {
        min-height: auto;
    }

    .sign-card p {
        max-width: 100%;
    }
}
@media (max-width: 768px) {

    .nav-container,
    .hero-container,
    .about-container,
    .signs-container,
    .features-container,
    .chatbot-container,
    .faq-container,
    .footer-container {
        width: calc(100% - 32px);
        max-width: 100%;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-container,
    .about-container,
    .features-container,
    .chatbot-container {
        grid-template-columns: 1fr;
    }

    .hero {
        min-height: auto;
        padding: 55px 0 65px;
    }

    .hero-copy {
        padding: 0;
        text-align: center;
    }

    .hero h1 {
        max-width: 100%;
        font-size: clamp(36px, 10vw, 48px);
        line-height: 1.08;
    }

    .hero-description {
        max-width: 100%;
        margin-left: auto;
        margin-right: auto;
        font-size: 14px;
    }

    .hero-badge,
    .hero-buttons,
    .hero-trust {
        justify-content: center;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-visual {
        width: 100%;
        min-height: 420px;
        margin-top: 25px;
    }

    .brain-image {
        width: min(420px, 88%);
        max-height: none;
    }

    .floating-card {
        display: none;
    }

    .about-section,
    .signs-section,
    .features-section,

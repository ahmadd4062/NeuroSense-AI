/* =========================
   FAQ SECTION
========================= */

.faq-section {
    padding: 105px 0;
    background:
        radial-gradient(
            circle at 82% 10%,
            rgba(11, 114, 239, 0.05),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #f8fbff 0%,
            #eef6ff 100%
        );
}

.faq-container {
    width: min(1280px, calc(100% - 70px));
    margin: 0 auto;
}

.faq-top {
    margin-bottom: 65px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 80px;
}

.faq-heading {
    max-width: 570px;
}

.faq-heading h2 {
    color: var(--navy);
    font-size: clamp(40px, 3.5vw, 56px);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -1.5px;
}

.faq-heading h2 span {
    display: block;
    color: var(--primary);
}

.faq-intro {
    max-width: 560px;
    padding-bottom: 8px;
}

.faq-intro p {
    color: #5f6d82;
    font-size: 15px;
    line-height: 1.75;
}

.faq-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.faq-item {
    border: 1px solid #d8e6f5;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.94);
    overflow: hidden;
    transition:
        border-color 0.3s ease,
        box-shadow 0.3s ease,
        background 0.3s ease,
        transform 0.3s ease;
}

.faq-item:hover {
    border-color: rgba(11, 114, 239, 0.36);
    box-shadow: 0 12px 30px rgba(41, 79, 130, 0.07);
}

.faq-item.active {
    border-color: rgba(11, 114, 239, 0.52);
    background: #ffffff;
    box-shadow: 0 16px 34px rgba(41, 79, 130, 0.09);
}

.faq-question {
    width: 100%;
    min-height: 76px;
    padding: 0 25px;
    border: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: var(--navy);
    background: transparent;
    font-family: inherit;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
}

.faq-question > span:first-child {
    flex: 1;
}

.faq-arrow {
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--primary);
    background: #eef6ff;
    font-size: 13px;
    transition:
        color 0.3s ease,
        background 0.3s ease,
        transform 0.35s ease;
}

.faq-item:hover .faq-arrow {
    color: #ffffff;
    background: var(--primary);
}

.faq-item.active .faq-arrow {
    color: #ffffff;
    background: var(--primary);
    transform: rotate(90deg);
}

.faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s ease;
}

.faq-item.active .faq-answer {
    grid-template-rows: 1fr;
}

.faq-answer-inner {
    overflow: hidden;
}

.faq-answer-inner p {
    max-width: 1020px;
    padding: 0 76px 25px 25px;
    color: #64738a;
    font-size: 14px;
    line-height: 1.75;
    opacity: 0;
    transform: translateY(-8px);
    transition:
        opacity 0.3s ease,
        transform 0.35s ease;
}

.faq-item.active .faq-answer-inner p {
    opacity: 1;
    transform: translateY(0);
}

/* FAQ entrance animation */

.faq-item {
    opacity: 1;
    transform: none;
    border: 1px solid #d8e6f5;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.94);
    overflow: hidden;
    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease,
        background 0.3s ease;
}

.faq-item:hover {
    transform: translateY(-2px);
    border-color: rgba(11, 114, 239, 0.36);
    box-shadow: 0 12px 30px rgba(41, 79, 130, 0.07);
}

.faq-item.active {
    transform: none;
    border-color: rgba(11, 114, 239, 0.52);
    background: #ffffff;
    box-shadow: 0 16px 34px rgba(41, 79, 130, 0.09);
}

/* Responsive */

@media (max-width: 900px) {
    .faq-section {
        padding: 80px 0;
    }

    .faq-container {
        width: min(100% - 40px, 760px);
    }

    .faq-top {
        margin-bottom: 50px;
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .faq-heading,
    .faq-intro {
        max-width: 650px;
    }

    .faq-intro {
        padding-bottom: 0;
    }
}

@media (max-width: 600px) {
    .faq-section {
        padding: 65px 0;
    }

    .faq-container {
        width: calc(100% - 28px);
    }

    .faq-heading h2 {
        font-size: 37px;
        letter-spacing: -1px;
    }

    .faq-intro p {
        font-size: 14px;
    }

    .faq-list {
        gap: 12px;
    }

    .faq-question {
        min-height: 70px;
        padding: 0 17px;
        gap: 15px;
        font-size: 15px;
    }

    .faq-arrow {
        width: 34px;
        height: 34px;
        font-size: 11px;
    }

    .faq-answer-inner p {
        padding: 0 58px 21px 17px;
        font-size: 13px;
    }
}


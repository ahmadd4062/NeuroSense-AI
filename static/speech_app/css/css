html,
body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

img {
    max-width: 100%;
    height: auto;
}

section {
    width: 100%;
}
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #0b72ef;
    --primary-dark: #075ac4;
    --navy: #071747;
    --text: #5b6d88;
    --soft-blue: #eef6ff;
    --line: #e3ebf6;
    --white: #ffffff;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    color: var(--navy);
    background: #ffffff;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    max-width: 100%;
}

.site-header {
    width: 100%;
    height: 74px;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid #e8eef7;
    position: relative;
    z-index: 50;
}

.nav-container {
    width: min(1380px, calc(100% - 72px));
    height: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 300px 1fr 250px;
    align-items: center;
    gap: 24px;
}

.brand {
    width: 225px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.brand img {
    width: 215px;
    height: 38px;
    object-fit: contain;
    object-position: left center;
}

.brand span {
    margin-top: -2px;
    padding-left: 47px;
    color: #70809a;
    font-size: 9px;
    white-space: nowrap;
}

.desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(22px, 2.4vw, 42px);
}

.desktop-nav a {
    color: #101936;
    font-size: 13px;
    font-weight: 600;
    transition: color 0.2s ease;
}

.desktop-nav a:hover,
.desktop-nav a.active {
    color: var(--primary);
}

.nav-actions {
    display: flex;
    justify-content: flex-end;
    gap: 13px;
}


.menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    color: var(--navy);
    font-size: 22px;
    cursor: pointer;
}

.hero {
    min-height: calc(100vh - 74px);
    padding: 20px 0 28px;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(circle at 73% 38%, rgba(121, 177, 255, 0.14), transparent 34%), linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
}

.hero-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 72% 45%, rgba(115, 173, 255, 0.10), transparent 36%);
}

.hero-container {
    width: min(1320px, calc(100% - 70px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 44% 56%;
    align-items: center;
    gap: 20px;
    position: relative;
    z-index: 2;
}

.hero-copy {
    padding: 35px 0 40px;
    position: relative;
    z-index: 6;
}

.hero-badge {
    width: fit-content;
    min-height: 28px;
    padding: 0 13px;
    margin-bottom: 18px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 7px;
    color: #2867bd;
    background: #eef6ff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.01em;
}

.hero-badge i {
    font-size: 11px;
}

.badge-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #4e91ea;
}

.hero h1 {
    max-width: 500px;
    color: var(--navy);
    font-size: clamp(42px, 3.6vw, 58px);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -1.8px;
}

.hero h1 span {
    display: block;
    color: var(--primary);
}

.hero-description {
    max-width: 470px;
    margin-top: 20px;
    color: var(--text);
    font-size: 15px;
    line-height: 1.75;
}

.hero-buttons {
    display: flex;
    gap: 14px;
    margin-top: 25px;
}



.hero-trust {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 27px;
}

.trust-avatars {
    display: flex;
    align-items: center;
}

.avatar {
    width: 29px;
    height: 29px;
    margin-left: -7px;
    border: 2px solid #ffffff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
}

.avatar:first-child {
    margin-left: 0;
}

.avatar-one { background: #9d6a54; }
.avatar-two { background: #13293d; }
.avatar-three { background: #c58b71; }
.avatar-four { background: #16697a; }

.hero-trust p {
    color: #687895;
    font-size: 12px;
    line-height: 1.45;
}

.hero-trust strong {
    color: var(--primary);
}

.hero-visual {
    min-height: 520px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.visual-glow {
    position: absolute;
    width: 68%;
    height: 68%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 177, 255, 0.22), rgba(231, 243, 255, 0.06) 58%, transparent 74%);
    filter: blur(5px);
}

.brain-image {
    width: min(470px, 68%);
    max-height: 470px;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 18px 25px rgba(30, 90, 200, 0.15));
}

.floating-card {
    min-width: 170px;
    min-height: 68px;
    padding: 12px 15px;
    position: absolute;
    z-index: 4;
    border: 1px solid rgba(219, 229, 242, 0.95);
    border-radius: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.93);
    box-shadow: 0 13px 34px rgba(47, 83, 130, 0.09);
    backdrop-filter: blur(9px);
    animation: floating 4s ease-in-out infinite;
}

.card-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    font-size: 17px;
}

.card-icon.icon-blue { color: #0c70e8; background: #eef6ff; }
.card-icon.icon-purple { color: #7d46e9; background: #f4efff; }
.card-icon.icon-green { color: #10a87a; background: #e9fbf5; }
.card-icon.icon-orange { color: #f09a31; background: #fff5e8; }

.floating-card h3 {
    margin-bottom: 5px;
    color: #101d42;
    font-size: 11px;
    font-weight: 700;
}

.floating-card p {
    color: #687793;
    font-size: 9px;
    line-height: 1.45;
}

.card-gait {
    top: 18%;
    left: 8%;
    animation-delay: 0s;
}

.card-speech {
    top: 56%;
    left: 6%;
    animation-delay: 0.8s;
}

.card-behavior {
    top: 21%;
    right: 7%;
    animation-delay: 1.4s;
}

.card-insights {
    top: 59%;
    right: 6%;
    animation-delay: 2s;
}

@keyframes floating {
    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-9px);
    }
}


@media (max-width: 1180px) {
    .nav-container {
        grid-template-columns: 255px 1fr 220px;
    }

    .desktop-nav {
        gap: 18px;
    }

    .hero-container {
        grid-template-columns: 45% 55%;
    }

    .hero h1 {
        font-size: clamp(40px, 4vw, 53px);
    }

    .brain-image {
        width: min(445px, 66%);
    }

    .floating-card {
        min-width: 155px;
        padding: 10px 12px;
    }

    .card-gait { left: 4%; }
    .card-speech { left: 2%; }
    .card-behavior { right: 3%; }
    .card-insights { right: 2%; }
}

@media (max-width: 980px) {
    .site-header {
        height: 68px;
    }

    .nav-container {
        width: min(100% - 34px, 900px);
        grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .nav-actions {
        display: none;
    }

    .menu-toggle {
        display: block;
    }

    .hero {
        min-height: auto;
        padding-top: 16px;
    }

    .hero-container {
        width: min(100% - 34px, 760px);
        grid-template-columns: 1fr;
        text-align: center;
    }

    .hero-copy {
        padding-top: 45px;
        padding-bottom: 20px;
    }

    .hero-badge,
    .hero-buttons,
    .hero-trust {
        margin-left: auto;
        margin-right: auto;
        justify-content: center;
    }

    .hero h1,
    .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-visual {
        min-height: 500px;
        margin-top: -15px;
    }

    .brain-image {
        width: min(440px, 65%);
    }

    .card-gait { left: 4%; }
    .card-speech { left: 3%; }
    .card-behavior { right: 4%; }
    .card-insights { right: 3%; }
}

@media (max-width: 700px) {
    .hero-visual {
        min-height: 420px;
    }

    .brain-image {
        width: min(390px, 76%);
    }

    .floating-card {
        min-width: 138px;
        min-height: 58px;
        padding: 9px 10px;
        border-radius: 11px;
    }

    .card-icon {
        width: 31px;
        height: 31px;
        font-size: 14px;
    }

    .floating-card h3 {
        font-size: 9.5px;
    }

    .floating-card p {
        font-size: 7.8px;
    }
}

@media (max-width: 620px) {
    .brand {
        width: 185px;
    }

    .brand img {
        width: 180px;
        height: 34px;
    }

    .brand span {
        padding-left: 36px;
        font-size: 7.5px;
    }

    .hero-container {
        width: min(100% - 28px, 540px);
    }

    .hero h1 {
        font-size: 39px;
        letter-spacing: -1.2px;
    }

    .hero-description {
        font-size: 14px;
        line-height: 1.65;
    }

    .hero-buttons {
        width: 100%;
        flex-direction: column;
    }

    

    .hero-trust {
        align-items: flex-start;
    }

    .hero-visual {
        min-height: 360px;
        margin-top: 0;
    }

    .brain-image {
        width: 88%;
    }

    .floating-card {
        display: none;
    }
}
/* About Section */

.about-section {
    padding: 105px 0;
    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(11, 114, 239, 0.05),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #f7fbff 0%,
            #edf6ff 100%
        );
}

.about-container {
    width: min(1240px, calc(100% - 70px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 48% 52%;
    align-items: center;
    gap: 85px;
}

.about-image-wrapper {
    width: 100%;
    height: 580px;
    overflow: hidden;
    border-radius: 15px;
    background: #eef6ff;
}

.about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
}

.about-image-wrapper:hover .about-image {
    transform: scale(1.025);
}

.about-content {
    max-width: 610px;
}

.section-label {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
    color: #0b72ef;
    font-size: 14px;
    font-weight: 600;
}

.section-label i {
    font-size: 14px;
}

.about-content h2 {
    max-width: 590px;
    margin-bottom: 35px;
    color: #071747;
    font-size: clamp(40px, 3.5vw, 57px);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -1.5px;
}

.about-content h2 span {
    display: block;
    color: #0b72ef;
}

.about-description {
    max-width: 590px;
    margin-bottom: 14px;
    color: #5c6678;
    font-size: 16px;
    line-height: 1.65;
}

.about-statistics {
    display: flex;
    align-items: center;
    gap: 90px;
    margin-top: 38px;
    margin-bottom: 38px;
}

.about-stat h3 {
    margin-bottom: 10px;
    color: #071747;
    font-size: 34px;
    line-height: 1;
    font-weight: 500;
}

.about-stat p {
    color: #606b7d;
    font-size: 15px;
    line-height: 1.5;
}



/* About Section Responsive */

@media (max-width: 1050px) {
    .about-container {
        gap: 50px;
    }

    .about-image-wrapper {
        height: 510px;
    }

    .about-content h2 {
        font-size: 45px;
    }

    .about-statistics {
        gap: 55px;
    }
}

@media (max-width: 820px) {
    .about-section {
        padding: 80px 0;
    }

    .about-container {
        width: min(100% - 40px, 680px);
        grid-template-columns: 1fr;
        gap: 55px;
    }

    .about-image-wrapper {
        height: 500px;
    }

    .about-content {
        max-width: 100%;
    }

    .about-content h2 {
        max-width: 100%;
    }

    .about-description {
        max-width: 100%;
    }
}

@media (max-width: 550px) {
    .about-section {
        padding: 65px 0;
    }

    .about-container {
        width: calc(100% - 28px);
        gap: 40px;
    }

    .about-image-wrapper {
        height: 410px;
        border-radius: 12px;
    }

    .about-content h2 {
        margin-bottom: 25px;
        font-size: 37px;
        letter-spacing: -1px;
    }

    .about-description {
        font-size: 14px;
        line-height: 1.7;
    }

    .about-statistics {
        gap: 35px;
        margin-top: 30px;
        margin-bottom: 32px;
    }

    .about-stat h3 {
        font-size: 29px;
    }

    .about-stat p {
        font-size: 13px;
    }
}
